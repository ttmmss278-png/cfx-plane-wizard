{
  "name": "pelton-engineering-toolbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "build:dev": "vite build --mode development",
    "patch:jet-quality": "node scripts/patch-jet-quality-bundle.mjs",
    "test:jet-quality": "node scripts/verify-jet-quality-core.mjs",
    "patch:plane-wizard-units": "node scripts/patch-plane-wizard-units.mjs",
    "test:plane-wizard": "node scripts/verify-plane-wizard-units.mjs",
    "test:roundness": "node scripts/verify-roundness-deviation-core.mjs && node scripts/verify-roundness-data-io.mjs && node scripts/verify-roundness-project.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
